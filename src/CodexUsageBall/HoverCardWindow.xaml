<Window x:Class="CodexUsageBall.HoverCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage Hover"
        Width="286"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Grid x:Name="HoverVisual">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="HoverTranslation" />
        </Grid.RenderTransform>
        <Path x:Name="TopArrow" Data="M 0 7 L 8 0 L 16 7 Z" Width="16" Height="7"
              Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}"
              StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
        <Border Margin="0,7" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="14,11,14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Codex 用量" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="9"
                                   Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlanLabel}" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding Quotas}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource RaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="10,9" Margin="0,7,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" />
                                            <Border Margin="7,0,0,0" Padding="5,2" CornerRadius="5"
                                                    Background="{DynamicResource ControlBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisplayed}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="球体显示" FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{Binding UsageBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{Binding UsageBrush}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource ThinProgressBar}" Maximum="100"
                                                 Value="{Binding RemainingPercent, Mode=OneWay}" Foreground="{Binding UsageBrush}"
                                                 Margin="0,7,0,0" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UsedText}" FontSize="9"
                                                   Foreground="{DynamicResource SubtleBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ResetText}" FontSize="9"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="9,7" Margin="0,7,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorText}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
        <Path x:Name="BottomArrow" Data="M 0 0 L 8 7 L 16 0 Z" Width="16" Height="7"
              Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}"
              StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>
</Window>

<Window x:Class="CodexUsageBall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageBall.Controls"
        Title="Codex Usage Ball" Width="64" Height="64" MinWidth="48" MinHeight="48"
        SizeToContent="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="#00000000" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" WindowStartupLocation="Manual" Left="0" Top="0" Topmost="True"
        SnapsToDevicePixels="False" UseLayoutRounding="False"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale" RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Resources>
        <Style x:Key="CodexContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="7" Padding="6" MinWidth="156"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.42" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodexMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemSurface" Padding="11,9" Background="Transparent" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <TextBlock x:Name="SubmenuArrow" Text="›" FontSize="17" FontWeight="Light"
                                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Right" HorizontalOffset="-4" VerticalOffset="-7"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="None">
                                <Border Margin="7" Padding="6" MinWidth="174"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.42" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodexMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="10,5" Background="{DynamicResource DividerBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="BallHitArea" Width="64" Height="64" Cursor="Hand" Background="#00000000"
          MouseEnter="BallHitArea_OnMouseEnter" MouseLeave="BallHitArea_OnMouseLeave"
          MouseLeftButtonDown="BallHitArea_OnMouseLeftButtonDown"
          MouseMove="BallHitArea_OnMouseMove"
          MouseLeftButtonUp="BallHitArea_OnMouseLeftButtonUp">
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource CodexContextMenuStyle}"
                         Placement="MousePoint" Opened="ContextMenu_OnOpened" Closed="ContextMenu_OnClosed">
                <MenuItem Style="{StaticResource CodexMenuItemStyle}" Click="RefreshMenuItem_OnClick"
                          AutomationProperties.Name="刷新额度">
                    <MenuItem.Header>
                        <Grid Width="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="刷新额度" VerticalAlignment="Center" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="QuotaDisplayMenuItem" Style="{StaticResource CodexMenuItemStyle}"
                          AutomationProperties.Name="球体显示额度">
                    <MenuItem.Header>
                        <Grid Width="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="球体显示" VerticalAlignment="Center" />
                            <TextBlock x:Name="QuotaDisplayMenuValue" Grid.Column="2" Text="智能"
                                       FontSize="10" Foreground="{DynamicResource SubtleBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Style="{StaticResource CodexMenuItemStyle}" Click="SettingsMenuItem_OnClick"
                          AutomationProperties.Name="设置">
                    <MenuItem.Header>
                        <Grid Width="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator Style="{StaticResource CodexMenuSeparatorStyle}" />
                <MenuItem Style="{StaticResource CodexMenuItemStyle}" Click="ExitMenuItem_OnClick"
                          AutomationProperties.Name="退出">
                    <MenuItem.Header>
                        <Grid Width="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="退出" VerticalAlignment="Center" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <Viewbox Stretch="Fill">
            <Grid x:Name="BallVisual" Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="2" EnableClearType="False" />
                </Grid.CacheMode>
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BallScale" />
                </Grid.RenderTransform>

                <Ellipse Margin="0.8" Fill="{DynamicResource BallBodyBrush}"
                         Stroke="{DynamicResource BallBorderBrush}" StrokeThickness="1" />
                <Ellipse x:Name="RefreshHalo" Margin="5" Opacity="0"
                         Stroke="{Binding UsageBrush}" StrokeThickness="1.5"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="RefreshHaloScale" ScaleX="0.78" ScaleY="0.78" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Margin="3.5" Stroke="{DynamicResource BallInnerStrokeBrush}"
                         StrokeThickness="0.65" Opacity="0.10" />
                <Ellipse Width="34" Height="16" Margin="10,7,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Opacity="0.20" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#78FFFFFF" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <controls:UsageRing x:Name="BallUsageRing" Width="50" Height="50"
                                    Progress="{Binding RemainingPercent}"
                                    RingBrush="{Binding UsageBrush}"
                                    TrackBrush="{DynamicResource BallTrackBrush}"
                                    StrokeThickness="4.5" RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:UsageRing.RenderTransform>
                        <RotateTransform x:Name="RingRotation" />
                    </controls:UsageRing.RenderTransform>
                </controls:UsageRing>
                <TextBlock x:Name="RemainingTextLabel" Text="{Binding RemainingText}"
                           Foreground="{DynamicResource BallTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" Opacity="0"
                           Foreground="{Binding UsageBrush}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="RefreshGlyphRotation" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window x:Class="CodexUsageBall.SettingsPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage Ball Settings"
        Width="372" Height="560" MinWidth="340" MinHeight="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style x:Key="MeterSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="1,0">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{TemplateBinding Foreground}" BorderThickness="0" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Background="#F0F0EB">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{TemplateBinding Background}" Stroke="#111110" StrokeThickness="1" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#3B3B38" BorderThickness="0" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style x:Key="ThemeSegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentSurface" Margin="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="22">
        <Border.RenderTransform>
            <TranslateTransform x:Name="WindowTranslation" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>
            <Grid Margin="18,7,12,0" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="悬浮球设置" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="只保留常用选项" FontSize="10" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ResetAllButton" Height="28" Padding="10,0" Margin="0,0,4,0"
                            Style="{StaticResource FooterButton}" Content="恢复全部默认"
                            Click="ResetAllButton_OnClick" />
                    <Button Width="30" Height="30" Style="{StaticResource IconButton}" Content="×"
                            AutomationProperties.Name="关闭设置" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="18,8,10,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="外观" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,7" />
                <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12,9" Margin="0,0,0,13">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="球体大小" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="SizeValueText" HorizontalAlignment="Right" Text="64 px" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" Content="−" Click="DecreaseSizeButton_OnClick" />
                            <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="48" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True" Style="{StaticResource MeterSlider}" Margin="6,0" ValueChanged="SizeSlider_OnValueChanged" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Content="+" Click="IncreaseSizeButton_OnClick" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8" />
                        <Grid>
                            <TextBlock Text="球体透明度" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="OpacityValueText" HorizontalAlignment="Right" Text="100%" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource MeterSlider}" Margin="32,6,32,0" ValueChanged="OpacitySlider_OnValueChanged" />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,5" />
                        <Grid Height="36">
                            <TextBlock Text="外观主题" Style="{StaticResource SettingLabel}" />
                            <Border Width="180" Height="30" HorizontalAlignment="Right"
                                    Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="1">
                                <UniformGrid Rows="1" Columns="3">
                                    <RadioButton x:Name="SystemThemeOption" GroupName="ThemeSelection" Tag="System"
                                                 Style="{StaticResource ThemeSegmentButton}" Checked="ThemeOption_OnChecked">
                                        <TextBlock Text="跟随系统" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </RadioButton>
                                    <RadioButton x:Name="LightThemeOption" GroupName="ThemeSelection" Tag="Light"
                                                 Style="{StaticResource ThemeSegmentButton}" Checked="ThemeOption_OnChecked">
                                        <TextBlock Text="浅色" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </RadioButton>
                                    <RadioButton x:Name="DarkThemeOption" GroupName="ThemeSelection" Tag="Dark"
                                                 Style="{StaticResource ThemeSegmentButton}" Checked="ThemeOption_OnChecked">
                                        <TextBlock Text="深色" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="额度颜色" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,7" />
                <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="13" Padding="12,9" Margin="0,0,0,13">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="黄色提醒" Style="{StaticResource SettingLabel}" />
                            </StackPanel>
                            <TextBlock x:Name="WarningThresholdValueText" HorizontalAlignment="Right"
                                       Text="已用 70%" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <Slider x:Name="WarningThresholdSlider" Minimum="10" Maximum="90" TickFrequency="5"
                                IsSnapToTickEnabled="True" Style="{StaticResource MeterSlider}"
                                Foreground="{DynamicResource WarningBrush}" Margin="32,5,32,0"
                                ValueChanged="WarningThresholdSlider_OnValueChanged" />
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,7" />
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="红色警告" Style="{StaticResource SettingLabel}" />
                            </StackPanel>
                            <TextBlock x:Name="DangerThresholdValueText" HorizontalAlignment="Right"
                                       Text="已用 90%" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <Slider x:Name="DangerThresholdSlider" Minimum="20" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" Style="{StaticResource MeterSlider}"
                                Foreground="{DynamicResource DangerBrush}" Margin="32,5,32,0"
                                ValueChanged="DangerThresholdSlider_OnValueChanged" />
                        <Border Background="{DynamicResource ControlBrush}" CornerRadius="7" Padding="8,5" Margin="0,7,0,0">
                            <TextBlock x:Name="ColorRangeText" Text="低用量绿色 · 70% 达到黄色 · 90% 达到红色"
                                       HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubtleBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="行为" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,7" />
                <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12,2">
                    <StackPanel>
                        <Grid Height="38"><TextBlock Text="始终置顶" Style="{StaticResource SettingLabel}" /><CheckBox x:Name="TopmostToggle" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="TopmostToggle_OnChanged" Unchecked="TopmostToggle_OnChanged" /></Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Height="44">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="随 Codex 自动显示" Style="{StaticResource SettingLabel}" /><TextBlock Text="开机后静默等待 Codex" FontSize="9" Foreground="{DynamicResource SubtleBrush}" /></StackPanel>
                            <CheckBox x:Name="AutoShowWithCodexToggle" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="AutoShowWithCodexToggle_OnChanged" Unchecked="AutoShowWithCodexToggle_OnChanged" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Height="44">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Codex 关闭后隐藏" Style="{StaticResource SettingLabel}" /><TextBlock Text="关闭 30 秒后自动隐藏并停止读取" FontSize="9" Foreground="{DynamicResource SubtleBrush}" /></StackPanel>
                            <CheckBox x:Name="HideWhenCodexClosesToggle" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="HideWhenCodexClosesToggle_OnChanged" Unchecked="HideWhenCodexClosesToggle_OnChanged" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Height="44">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="单击切换额度" Style="{StaticResource SettingLabel}" /><TextBlock Text="在当前实际额度之间循环" FontSize="9" Foreground="{DynamicResource SubtleBrush}" /></StackPanel>
                            <CheckBox x:Name="SingleClickCyclesQuotaToggle" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="SingleClickCyclesQuotaToggle_OnChanged" Unchecked="SingleClickCyclesQuotaToggle_OnChanged" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                        <Grid Height="44">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="界面动画" Style="{StaticResource SettingLabel}" /><TextBlock Text="低性能设备可关闭" FontSize="9" Foreground="{DynamicResource SubtleBrush}" /></StackPanel>
                            <CheckBox x:Name="AnimationsToggle" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="AnimationsToggle_OnChanged" Unchecked="AnimationsToggle_OnChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,8,18,12">
                <TextBlock Text="Codex Usage Ball 1.8.7" FontSize="10" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                <Button x:Name="ExitButton" Content="退出程序" HorizontalAlignment="Right"
                        Style="{StaticResource FooterButton}" Click="ExitButton_OnClick" />
            </Grid>

            <Border x:Name="ResetAllOverlay" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0"
                    Background="#88000000" CornerRadius="21" Panel.ZIndex="40"
                    MouseLeftButtonDown="ResetAllOverlay_OnMouseLeftButtonDown">
                <Border x:Name="ResetAllCard" Width="276" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ResetAllCardScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                    <StackPanel>
                        <TextBlock Text="恢复全部默认设置？" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,16" TextWrapping="Wrap" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="球体外观、额度颜色、行为开关、额度选择、悬浮球位置和设置窗口大小都会恢复。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="取消" Height="34" Style="{StaticResource GhostButton}"
                                    Click="CancelResetAllButton_OnClick" />
                            <Button x:Name="ConfirmResetAllButton" Grid.Column="2" Height="34"
                                    Style="{StaticResource ActionButton}" Click="ConfirmResetAllButton_OnClick">
                                <TextBlock Text="恢复全部" Foreground="{DynamicResource PrimaryButtonTextBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <Canvas Grid.RowSpan="3" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,7,7" Opacity="0.28" IsHitTestVisible="False" Panel.ZIndex="10">
                <Line X1="3" Y1="10" X2="10" Y2="3" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />
                <Line X1="7" Y1="10" X2="10" Y2="7" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />
            </Canvas>
        </Grid>
    </Border>
</Window>
